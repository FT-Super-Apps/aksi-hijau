{
  "compilerOptions": {
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@components/*": ["src/components/*"],
      "@screens/*": ["src/screens/*"],
      "@navigation/*": ["src/navigation/*"],
      "@assets/*": ["assets/*"],
      "@utils/*": ["src/utils/*"],
      "@constants/*": ["src/constants/*"],
      "@config/*": ["src/config/*"],
      "@theme/*": ["src/theme/*"],
      "@store/*": ["src/store/*"]
    }
  },
  "exclude": ["node_modules", ".expo", ".expo-shared", "dist"]
}
